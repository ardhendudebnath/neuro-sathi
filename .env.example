# Copy to .env (git-ignored) and fill in. Never commit real values.
# In production these come from a secret manager, not a file.

ENV=development
OTP_DEV_ECHO=true            # development only: /auth/otp returns the code

# --- database passwords (docker compose) ---
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
SERVICE_DB_PASSWORD=

# --- auth ---
JWT_SECRET=                  # 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"

# --- SMS (OTP) ---
SMS_PROVIDER=console         # console (dev) | msg91
SMS_API_KEY=
SMS_TEMPLATE_ID=

# --- NVIDIA build.nvidia.com (server-side only) ---
NVIDIA_API_KEY=
SATHI_MODEL=sarvamai/sarvam-m
SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-multilingual-8b-v1
ASR_FUNCTION_ID=
TTS_FUNCTION_ID=
PAID_API_MONTHLY_BUDGET_INR=5000

# --- photo storage (MinIO locally, S3-compatible India-region bucket in production) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- push notifications (Firebase Admin service-account JSON path) ---
FIREBASE_CREDENTIALS_FILE=

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:8000
